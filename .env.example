# meerpad configuration. Copy to .env (`make config` does) and adjust.
#
# Read twice: by docker compose, which passes these into the container (see the
# `environment:` block in docker-compose.yml), and by app/config.py itself when
# the server runs natively (`make dev`). Every value is optional on a laptop;
# the defaults are the ones shown. Precedence: environment > .env > default.
# On Coolify none of this file is used: set the variables in its UI instead
# (COOLIFY.md).

# --- The app ------------------------------------------------------------------

# Where the app is reachable from a browser. Login and share links in emails are
# built from it, and its host is what separates "the app" from "a published
# website": a request for any other host is looked up as a site. It has to
# match the published port (MEERPAD_PORT). Production: https://meerpad.com
BASE_URL=http://localhost:8050

# Signs login codes. CHANGE THIS anywhere but your own laptop:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me

# The workspaces a brand-new account starts with, comma separated.
DEFAULT_WORKSPACES=Work,Private

# --- Database -----------------------------------------------------------------

# For `make dev` and the tests: the compose database on the host's loopback.
# Inside the stack compose overrides this with the `db` service's address.
DATABASE_URL=postgresql+psycopg://meerpad:meerpad@localhost:5435/meerpad

# The bundled Postgres. Change the password here and in DATABASE_URL together,
# and before the first `make up`: Postgres only reads it when it creates the
# database volume.
POSTGRES_USER=meerpad
POSTGRES_PASSWORD=meerpad
POSTGRES_DB=meerpad
# 5435: meerail has 5432, meercal 5433 and meerpic 5434.
MEERPAD_DB_PORT=5435

# --- Container topology -------------------------------------------------------

# Where docker compose publishes the app. Keep the 127.0.0.1 prefix unless a
# TLS proxy sits in front: the server trusts X-Forwarded-* from whoever can
# reach it (see the Dockerfile's CMD).
MEERPAD_BIND=127.0.0.1
# 8050: meerail has 8000, meercal 8010, meerink 8030, meerpic 8040. The dev
# overlay (docker-compose.dev.yml) uses 8051.
MEERPAD_PORT=8050

# --- Files --------------------------------------------------------------------

# Where uploads and Notion imports in progress are kept when running natively.
# Default: data/uploads and data/imports in the checkout. In the container they
# are /data/uploads and /data/imports, on the meerpad-data volume.
# UPLOAD_DIR=./data/uploads
# IMPORT_DIR=./data/imports

# Largest file you can drop into a page, in bytes (50 MB).
MAX_UPLOAD_BYTES=52428800
# Largest Notion export zip, in bytes (4 GB): a whole workspace with every
# attachment in it.
MAX_IMPORT_BYTES=4294967296

# --- Email --------------------------------------------------------------------

# Sign-in is an emailed magic link plus a code (meerato's flow). Leave
# SMTP_HOST empty and both are printed to the server log instead (`make logs`),
# which is all a laptop needs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=hello@meerpad.com

# --- Sign-in ------------------------------------------------------------------

# Lifetimes in minutes. The emailed code shares the link's.
LOGIN_TOKEN_TTL_MINUTES=30
SESSION_TTL_MINUTES=43200
# Wrong guesses before an emailed code is destroyed.
LOGIN_CODE_MAX_ATTEMPTS=5
# Requests per email address within the window: sign-in emails, code checks.
LOGIN_RATE_MAX=5
VERIFY_RATE_MAX=15
LOGIN_RATE_WINDOW_MINUTES=15

# --- Published websites -------------------------------------------------------

# Every published page is at <BASE_URL>/v/<name> (the owner picks the name),
# which needs no DNS or proxy setup. A custom domain can point at a site too;
# see COOLIFY.md.

# This server's public IPv4: the address the publish dialog tells people to
# point a custom domain's A record at. Purely informational, the server never
# checks DNS. Empty hides the hint.
PUBLIC_IP=

# --- Fetching pasted links ----------------------------------------------------

# "Download this pasted image/PDF link into the page" fetches the URL on the
# server. Private, loopback and link-local addresses are refused unless this is
# true, which only makes sense on a developer machine.
FETCH_ALLOW_PRIVATE=false
FETCH_TIMEOUT_SECONDS=20

# --- Page history -------------------------------------------------------------

# Edits to a page are grouped into sessions, and the page is kept as each
# session left it, so its history shows what every session changed. A session
# ends after HISTORY_IDLE_MINUTES without an edit, or once it is
# HISTORY_MAX_SESSION_MINUTES old. HISTORY_KEEP_SESSIONS finished sessions are
# kept per page; older ones are dropped.
HISTORY_IDLE_MINUTES=10
HISTORY_MAX_SESSION_MINUTES=60
HISTORY_KEEP_SESSIONS=200
